# Copy to e2e/.env.local, which Git ignores. Never commit real values.
BASE_URL=http://127.0.0.1:18080
E2E_CHAIN_ID=akash-bridge-v2-testnetify-dev-1
# Completed owner/height/sequence ID for the read-only transfer tracking specs.
E2E_MINTED_TRANSFER_ID=
# Required only by the refund test. Use an on-curve SPL token account on the
# actual test network. The portal accepts it, but token-program ownership
# makes the mint program void the accepted deposit so Akash can refund it.
E2E_VOIDED_SOLANA_ADDRESS=
# Funded testnet wallet. Without it, only read-only specs run.
TEST_WALLET_MNEMONIC=
# Each transfer test spends testnet AKT and a transaction fee.
E2E_SEND_TRANSFER=false
# true tests this checkout's portal build against the live testnet APIs.
E2E_LOCAL_UI=false
