# Copy to e2e/.env.local, which Git ignores. Never commit real values.
BASE_URL=http://127.0.0.1:18080
E2E_CHAIN_ID=akash-bridge-testnetify-dev-1
# Funded testnet wallet. Without it, only read-only specs run.
TEST_WALLET_MNEMONIC=
# Each run of e2e/transfer.spec.ts sends the minimum transfer plus the fee.
E2E_SEND_TRANSFER=false
# true tests this checkout's portal build against the live testnet APIs.
E2E_LOCAL_UI=false
