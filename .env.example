# Copy server/config.example.json to portal.config.json and set network pins.
PORTAL_CONFIG=portal.config.json

# The local API started by npm run dev. Override to use another portal server.
PORTAL_API_URL=http://127.0.0.1:8080

# Optional public Reown project ID; the portal's existing ID is used by default.
# WALLETCONNECT_PROJECT_ID=your-project-id
