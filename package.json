{
  "name": "sink-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Web portal for Akash Sink transfers from Akash to Solana",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "sdk": "bash scripts/pack-sdk.sh",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:spec",
    "test:unit": "tsx --test *.test.ts",
    "test:spec": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@akashnetwork/chain-sdk": "file:.cache/chain-sdk.tgz",
    "@cosmjs/encoding": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@cosmjs/tendermint-rpc": "0.39.0",
    "@noble/curves": "1.9.7",
    "@scure/base": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cosmjs-types": "0.11.0",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "playwright": "1.56.1",
    "postcss": "8.5.30",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vitest-mock-extended": "5.1.1",
    "zod": "4.6.5"
  }
}
